diff --git a/gcc/ada/Makefile.rtl b/gcc/ada/Makefile.rtl
index 61600adf1..37454b3e8 100644
--- a/gcc/ada/Makefile.rtl
+++ b/gcc/ada/Makefile.rtl
@@ -2302,8 +2302,14 @@ ifeq ($(strip $(filter-out cygwin% mingw32% pe,$(target_os))),)
