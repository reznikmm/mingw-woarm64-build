+        EXTRA_GNATRTL_NONTASKING_OBJS += $(GNATRTL_128BIT_OBJS)
+        SO_OPTS = -Wl,-soname,
+      else
+        LIBGNAT_TARGET_PAIRS += $(X86_TARGET_PAIRS)
+        SO_OPTS = -m32 -Wl,-soname,
+      endif
     endif
   endif
 
